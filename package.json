{
  "name": "mindmap-local",
  "version": "0.6.0-alpha.19",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/sync-sql-wasm.mjs",
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:state-core": "node --experimental-strip-types --test tests/state-core-phase1.test.mjs",
    "test:storage-contract": "node --experimental-strip-types --test tests/storage-contract-phase2a.test.mjs",
    "test:indexeddb-storage": "node --experimental-strip-types --test tests/native-indexeddb-storage-phase2b.test.mjs",
    "test:graph-storage": "node --experimental-strip-types --test tests/graph-storage-phase2ca.test.mjs tests/graph-storage-indexeddb-phase2ca.test.mjs",
    "build:storage-harness": "vite build --config tools/browser-state-storage-harness/vite.config.mjs",
    "test:browser-storage": "node scripts/run-browser-state-storage-harness.mjs",
    "build:graph-storage-harness": "vite build --config tools/browser-graph-storage-harness/vite.config.mjs",
    "test:browser-graph-storage": "node scripts/run-browser-graph-storage-harness.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "check:docs": "bash scripts/check-release-docs.sh",
    "test:macos": "node --test tests/macos-launcher.test.mjs tests/model-launch-configuration.test.mjs tests/ui-recovery.test.mjs",
    "package:source": "bash scripts/package-source.sh",
    "package:legacy-exporter": "bash scripts/package-legacy-exporter.sh",
    "test:migration-contract": "node --experimental-strip-types --test tests/phase2cb-mapping-contract.test.mjs tests/phase2cb-b1a-executor.test.mjs tests/phase2cb-b1a-indexeddb.test.mjs tests/phase2cb-b1a-sqlite-source.test.mjs tests/phase2cb-b1b-executor.test.mjs tests/phase2cb-b1b-exact-source.test.mjs tests/phase2cb-b1b-one-shot.test.mjs tests/phase2cb-b1b-packaging.test.mjs",
    "test:phase2cb-b1a": "node --experimental-strip-types --test tests/phase2cb-b1a-executor.test.mjs tests/phase2cb-b1a-indexeddb.test.mjs tests/phase2cb-b1a-sqlite-source.test.mjs",
    "build:phase2cb-b1a-harness": "vite build --config tools/browser-phase2cb-b1a-harness/vite.config.mjs",
    "test:browser-phase2cb-b1a": "node scripts/run-browser-phase2cb-b1a-harness.mjs",
    "test:phase2cb-b1b": "node --experimental-strip-types --test tests/phase2cb-b1b-executor.test.mjs tests/phase2cb-b1b-exact-source.test.mjs tests/phase2cb-b1b-one-shot.test.mjs tests/phase2cb-b1b-packaging.test.mjs",
    "build:phase2cb-b1b-harness": "vite build --config tools/browser-phase2cb-b1b-harness/vite.config.mjs",
    "test:browser-phase2cb-b1b": "node scripts/run-browser-phase2cb-b1b-harness.mjs",
    "package:phase2cb-b1b": "bash scripts/package-phase2cb-b1b.sh"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "MindMap"
}
